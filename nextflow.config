/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/stamp Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // Pipeline mode
    mode                       = 'bulk'    // 'bulk' | 'sc'

    // Bulk analysis toggles (ignored in sc mode)
    run_marine                 = true
    run_sailor                 = true
    run_flare                  = false    // FLARE edit-cluster identification for RBP-STAMP (requires run_sailor). Leave false for RiboSTAMP.

    // Reference genome files
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false
    fasta                      = null      // reference genome FASTA (samtools calmd + SAILOR)
    star_index                 = null      // pre-built STAR index directory
    gtf                        = null      // GTF annotation (STAR + featureCounts)
    gene_bed                   = null      // BED6 gene models (RSeQC + MARINE annotation)
    dbsnp_bed                  = null      // dbSNP BED for SNP filtering
    cellranger_ref             = null      // pre-built CellRanger reference (sc FASTQ mode only)

    // Edit calling
    edit_type                  = 'C>T'    // 'C>T' (A-to-I reverse strand) | 'A>G' (sense strand)
    marine_sif                 = null      // path to MARINE Singularity SIF
    ribostamp_utils_sif        = null      // path to ribostamp_utils SIF (overrides Docker Hub pull)
    barcode_tag                = 'CB'     // BAM tag for cell barcodes (sc mode)
    strandedness               = null      // 0/1/2 — required for SAILOR-from-BAM; auto-inferred otherwise
    min_base_quality           = 30
    min_read_quality           = 255      // 255 = CellRanger mapping quality

    // Edit filtering — thresholds
    min_count                  = 3        // minimum edited reads per site (sc mode)
    max_frac                   = 0.1      // maximum editing fraction (all modes)

    // Edit filtering — per-filter on/off switches (set to false to skip that filter)
    // Bulk filters (helper_filter_edits_bulk.py)
    filter_bulk_multiallelic   = true     // F1: remove sites with >1 alt base at same position
    filter_bulk_dbsnp          = true     // F2: remove sites overlapping dbSNP
    filter_bulk_max_frac       = true     // F3: remove sites where edit_fraction > max_frac
    filter_bulk_unannotated    = true     // F4: remove sites with no gene annotation
    // SC filters (helper_filter_edits_sc.py)
    filter_sc_multi_conversion = true     // F1: remove barcodes with >1 conversion type per site
    filter_sc_dbsnp            = true     // F2: remove sites overlapping dbSNP
    filter_sc_min_count        = true     // F3: remove sites with < min_count total edited reads
    filter_sc_max_frac         = true     // F4: remove sites where edit_fraction > max_frac
    filter_sc_unannotated      = true     // F5: remove sites with no gene annotation

    // SAILOR / Snakemake options
    sailor_snakefile           = "${projectDir}/assets/workflow_sailor/Snakefile"  // bundled SAILOR; override to use a different version
    sailor_snakemake_path      = 'snakemake'  // absolute path to snakemake binary, or 'snakemake' if in PATH
                                              // e.g. '/path/to/conda/envs/snakemake/bin/snakemake'
    sailor_singularity_cache   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: null  // defaults to $NXF_SINGULARITY_CACHEDIR; override with --sailor_singularity_cache /path
    sailor_singularity_bind    = null     // comma-separated bind paths for SAILOR's internal Singularity calls
                                          // e.g. '/condo/brannanlab,/home/user/refs'
                                          // Must cover locations of --fasta and --dbsnp_bed
                                          // Note: sailor_snakemake_path and sailor_singularity_* are also used by FLARE (both drive Snakemake).

    // FLARE options (RBP-STAMP edit-cluster identification; only used when --mode bulk and --run_flare true)
    flare_snakefile            = "${projectDir}/assets/workflow_FLARE/Snakefile"  // bundled FLARE; override to use a different version
    flare_regions              = null     // pre-built regions folder from generate_regions.py (genome-level, ~8-10 GB, reusable).
                                          // If null, generated on-the-fly from --gtf (cached). Build once and reuse via this param.
    flare_window_size          = 30       // sliding-window size for generate_regions.py (only when auto-generating regions)
    flare_fdr                  = 0.1       // FDR threshold for cluster/peak filtering
    flare_max_merge_dist       = 15        // max distance (bp) for merging adjacent significant peaks
    editc_sif                  = null      // path to local editc Singularity SIF for FLARE region generation (offline HPC); defaults to Docker Hub pull

    // metaPlotR options
    // Built-in genePred files live in assets/genepred/ and are selected automatically via --genome.
    // Supported values: hg19, hg38, hg38_V44, mm10, mm39.
    // To use a custom genome, supply --genepred /path/to/your_refseq_genePred.txt.gz
    genepred                   = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '1h'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // Set cacheDir to a shared directory so SIF images are only pulled once
        // and reused across runs. Without this, images are re-downloaded on every run.
        // Recommended: singularity.cacheDir = '/condo/brannanlab/singularity_cache'
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test            { includeConfig 'conf/test.config'             }
    test_bulk_bam   { includeConfig 'conf/test_bulk_bam.config'   }
    test_bulk_fastq { includeConfig 'conf/test_bulk_fastq.config' }
    test_bulk_bam_flare   { includeConfig 'conf/test_bulk_bam_flare.config'   }
    test_bulk_fastq_flare { includeConfig 'conf/test_bulk_fastq_flare.config' }
    test_sc_bam     { includeConfig 'conf/test_sc_bam.config'     }
    test_sc_fastq   { includeConfig 'conf/test_sc_fastq.config'   }
    test_full       { includeConfig 'conf/test_full.config'       }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/stamp custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load nf-core/stamp custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/stamp.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/stamp'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Aravind Sundaravadivelu',
            affiliation: 'Houston Methodist Research Institute, Brannan Lab',
            email: 'aravind.sunda@gmail.com',
            github: 'aravindsundaravadivelu',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/nf-core/stamp'
    description     = """A pipeline to process bulk and single cell ribo and RBP STAMP datasets"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.6.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet // originally 2.5.1
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
