/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEST PROFILE: test_bulk_fastq
    Mode:         Bulk RNA-seq, FASTQ-start
    Species:      Human (hg38 / GRCh38-2024-A + mRuby/GFP)
    Data:         HEK293T-TERT, RPS2-BAMR riboSTAMP (dox on/off), SE
                  FASTQs converted from chr1-subsampled BAMs (~150k reads per sample)
    Edit type:    C>T (cytidine deaminase, reverse strand)
    Tools tested: FASTQC → FASTP → STAR_ALIGN → INFER_STRANDEDNESS → MARINE_BULK
                  → SAILOR → FEATURECOUNTS → MERGE_COUNTS → FILTER_EDITS_BULK
                  → NORMALIZE_EDITS_BULK → METAPLOTR_BULK → MULTIQC
    Prerequisites (all in assets/test_data/, generated by bin/make_test_dataset.sh):
      - assets/test_data/bulk_fastqs/ctrl_chr1_R1.fastq.gz
      - assets/test_data/bulk_fastqs/exp_chr1_R1.fastq.gz
      - assets/test_data/refs/star_index_hg38_chr1/
      - assets/test_data/refs/hg38_chr1.fa
      - assets/test_data/refs/chr1_hg38_genes.gtf.gz
      - assets/test_data/refs/chr1_hg38_genes.bed.gz
      - assets/test_data/refs/chr1_hg38_dbsnp.bed
    SAILOR prerequisites (must be configured per system):
      - Snakemake installed; set sailor_snakemake_path if not on PATH
      - Singularity available
    Run with:
      sbatch bin/run_pipeline_test.sh test_bulk_fastq
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   16,
        memory: '64.GB',
        time:   '2.h'
    ]
}

params {
    config_profile_name        = 'Test — bulk FASTQ-start (hg38)'
    config_profile_description = 'Bulk FASTQ-start: chr1-subsampled HEK293T RPS2-BAMR riboSTAMP, hg38, C>T, SE'

    // ── Mode ──────────────────────────────────────────────────────────────────
    mode       = 'bulk'
    run_marine = true
    run_sailor = true

    // ── Input ─────────────────────────────────────────────────────────────────
    input = "${projectDir}/assets/test_data/samplesheets/samplesheet_bulk_fastq.csv"

    // ── Reference files (chr1-only, bundled in assets/test_data/refs/) ────────
    // chr1-only STAR index keeps alignment fast for test (~1 min vs ~30 min full genome)
    star_index = "${projectDir}/assets/test_data/refs/star_index_hg38_chr1"
    fasta      = "${projectDir}/assets/test_data/refs/hg38_chr1.fa"
    gtf        = "${projectDir}/assets/test_data/refs/chr1_hg38_genes.gtf.gz"
    gene_bed   = "${projectDir}/assets/test_data/refs/chr1_hg38_genes.bed.gz"
    genome     = 'hg38'

    // ── Variant filtering ─────────────────────────────────────────────────────
    dbsnp_bed = "${projectDir}/assets/test_data/refs/chr1_hg38_dbsnp.bed"

    // ── SAILOR ────────────────────────────────────────────────────────────────
    // sailor_snakefile defaults to ${projectDir}/assets/workflow_sailor/Snakefile (bundled)
    // Set sailor_snakemake_path if snakemake is not on PATH, e.g.:
    //   sailor_snakemake_path = '/path/to/conda/envs/snakemake/bin/snakemake'
    // Set sailor_singularity_cache to avoid re-pulling containers on each run, e.g.:
    //   sailor_singularity_cache = '/path/to/singularity_cache'
    // Set sailor_singularity_bind if reference files are on a non-standard mount, e.g.:
    //   sailor_singularity_bind = '/scratch,/data'

    // ── Edit calling ──────────────────────────────────────────────────────────
    edit_type        = 'C>T'
    min_base_quality = 30
    min_read_quality = 0
    max_frac         = 0.1

    // ── Filters — all disabled for test (maximise sites reaching downstream steps)
    filter_bulk_multiallelic = false
    filter_bulk_dbsnp        = false
    filter_bulk_max_frac     = false
    filter_bulk_unannotated  = false
}
