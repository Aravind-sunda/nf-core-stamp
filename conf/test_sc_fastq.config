/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEST PROFILE: test_sc_fastq
    Mode:         Single-cell (10x Chromium), FASTQ-start
    Species:      Mouse (mm10 / mRuby3_mm10)
    Edit type:    C>T (cytidine deaminase, reverse strand)
    Tools tested: CELLRANGER → MARINE_SC → FILTER_EDITS_SC → NORMALIZE_EDITS_SC
                  → MULTIQC
    Prerequisites (all in assets/test_data/, transferred as part of the test_data bundle):
      - assets/test_data/sc_fastqs/ctrl/   (R1/R2 FASTQs, CellRanger naming convention)
      - assets/test_data/sc_fastqs/exp/
      - assets/test_data/refs/cellranger_ref_mm10/  (full CellRanger mkref output)
      - assets/test_data/refs/chr1_mm10_genes.bed.gz
      - assets/test_data/refs/chr1_mm10_dbsnp.bed
    NOTE: CellRanger requires a licensed binary and substantial compute resources
          (32+ CPUs, 64+ GB RAM, ~1–2h). The chr1-only FASTQs give sparse counts
          (only chr1 genes covered) — results are not biologically meaningful but
          are sufficient to verify the full FASTQ→CellRanger→MARINE→normalize path.
          Use test_sc_bam to test the SC MARINE/normalize steps without CellRanger.
    Run with:
      sbatch bin/run_pipeline_test.sh test_sc_fastq
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   32,
        memory: '128.GB',
        time:   '4.h'
    ]
}

params {
    config_profile_name        = 'Test — SC FASTQ-start (mm10)'
    config_profile_description = 'SC FASTQ-start: mESC 10x Chromium, mm10, C>T — runs CellRanger'

    // ── Mode ──────────────────────────────────────────────────────────────────
    mode       = 'sc'
    run_marine = true

    // ── Input ─────────────────────────────────────────────────────────────────
    // sample,fastq_dir  — each fastq_dir holds {sample}_S1_L001_R{1,2}_001.fastq.gz
    // FASTQs are generated from chr1-subsampled CellRanger BAMs by make_test_dataset.sh
    input = "${projectDir}/assets/test_data/samplesheets/samplesheet_sc_fastq.csv"

    // ── CellRanger reference ───────────────────────────────────────────────────
    // Pre-built CellRanger reference (mkref output); full genome required by CellRanger.
    // Place the reference directory at assets/test_data/refs/cellranger_ref_mm10/.
    cellranger_ref = "${projectDir}/assets/test_data/refs/cellranger_ref_mm10"

    // ── Reference files (mm10) ────────────────────────────────────────────────
    // fasta: must match the genome CellRanger aligned to (full genome from the ref).
    fasta    = "${projectDir}/assets/test_data/refs/cellranger_ref_mm10/fasta/genome.fa"
    // gene_bed: chr1-only BED used by MARINE for annotation (sufficient for chr1 BAMs).
    gene_bed = "${projectDir}/assets/test_data/refs/chr1_mm10_genes.bed.gz"

    // ── Variant filtering ─────────────────────────────────────────────────────
    dbsnp_bed = "${projectDir}/assets/test_data/refs/chr1_mm10_dbsnp.bed"

    // ── Edit calling ──────────────────────────────────────────────────────────
    edit_type        = 'C>T'
    min_base_quality = 30
    min_read_quality = 0
    max_frac         = 0.1
    min_count        = 3
    barcode_tag      = 'CB'

    // ── Filters — all disabled for test (maximise sites reaching downstream steps)
    filter_sc_multi_conversion = false
    filter_sc_dbsnp            = false
    filter_sc_min_count        = false
    filter_sc_max_frac         = false
    filter_sc_unannotated      = false
}
