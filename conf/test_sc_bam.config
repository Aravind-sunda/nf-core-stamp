/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEST PROFILE: test_sc_bam
    Mode:         Single-cell (10x Chromium), BAM-start
    Species:      Mouse (mm10 / mRuby3_mm10)
    Data:         mESC TCA timepoint t1 (wt vs shCTRL), 10x Chromium v3
                  chr1-subsampled ~500k reads per sample
    Edit type:    C>T (cytidine deaminase, reverse strand)
    Tools tested: MARINE_SC → FILTER_EDITS_SC → NORMALIZE_EDITS_SC → MULTIQC
                  (strandedness fixed at 2 for 10x STAMP; no INFER_STRANDEDNESS)
                  (expression matrix from CellRanger outs; no featureCounts)
    Prerequisites (all in assets/test_data/, generated by bin/make_test_dataset.sh
                   or transferred as part of the test_data bundle):
      - assets/test_data/sc_bams/ctrl_chr1.bam
      - assets/test_data/sc_bams/exp_chr1.bam
      - assets/test_data/sc_matrix/ctrl/filtered_feature_bc_matrix/
      - assets/test_data/sc_matrix/exp/filtered_feature_bc_matrix/
      - assets/test_data/refs/mm10_chr1.fa          (chr1-only mm10 FASTA)
      - assets/test_data/refs/chr1_mm10_genes.bed.gz
      - assets/test_data/refs/chr1_mm10_dbsnp.bed
    Run with:
      sbatch bin/run_pipeline_test.sh test_sc_bam
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   16,
        memory: '64.GB',
        time:   '2.h'
    ]
}

params {
    config_profile_name        = 'Test — SC BAM-start (mm10)'
    config_profile_description = 'SC BAM-start: chr1-subsampled mESC TCA t1, mm10, C>T, 10x Chromium v3'

    // ── Mode ──────────────────────────────────────────────────────────────────
    mode       = 'sc'
    run_marine = true

    // ── Input ─────────────────────────────────────────────────────────────────
    // sample,bam,matrix_dir  (generated by make_test_dataset.sh)
    input = "${projectDir}/assets/test_data/samplesheets/samplesheet_sc_bam.csv"

    // ── Reference files (mm10, chr1-only subset bundled in test_data/refs/) ───
    // fasta required for samtools calmd if BAMs lack MD tags (CellRanger BAMs have them,
    // but included for safety on chr1-subsampled BAMs)
    fasta    = "${projectDir}/assets/test_data/refs/mm10_chr1.fa"
    // gene_bed: BED6 gene model used by MARINE for annotation and edit calling
    gene_bed = "${projectDir}/assets/test_data/refs/chr1_mm10_genes.bed.gz"

    // ── Variant filtering ─────────────────────────────────────────────────────
    // mm10 chr1-only subset of dbSNP142 (generated by make_test_dataset.sh)
    dbsnp_bed = "${projectDir}/assets/test_data/refs/chr1_mm10_dbsnp.bed"

    // ── Edit calling ──────────────────────────────────────────────────────────
    edit_type        = 'C>T'
    min_base_quality = 30
    min_read_quality = 0
    max_frac         = 0.1
    min_count        = 3    // min cells with edited reads to keep a site
    barcode_tag      = 'CB' // CellRanger standard cell barcode tag

    // ── Filters — all disabled for test (maximise sites reaching downstream steps)
    filter_sc_multi_conversion = false
    filter_sc_dbsnp            = false
    filter_sc_min_count        = false
    filter_sc_max_frac         = false
    filter_sc_unannotated      = false
}
