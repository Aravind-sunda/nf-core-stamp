/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/stamp — MASTER RUN CONFIG (template)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    One config that covers every supported run scenario. Copy it next to your data,
    uncomment the block for your scenario, comment out the rest.

        cp conf/master.config /path/to/my_project/my_run.config
        # edit my_run.config
        nextflow run /path/to/nf-core-stamp/main.nf \
            -c        /path/to/my_project/my_run.config \
            -profile  singularity \
            --outdir  /path/to/my_project/results \
            -resume

    (bin/run_pipeline.sh is already wired for this — set PROFILE= to your copy.)

    ── SCENARIO CHEAT-SHEET ─────────────────────────────────────────────────────────
    Every scenario needs: input, fasta, gene_bed, dbsnp_bed, edit_type, outdir
    On top of that:

      SCENARIO              mode  run_*             EXTRA REQUIRED      NOT USED
      ────────────────────  ────  ────────────────  ──────────────────  ─────────────────
      bulk BAM-start        bulk  marine,sailor     gtf, genome         star_index,
                                                                        cellranger_ref
      bulk FASTQ-start      bulk  marine,sailor     gtf, genome,        cellranger_ref
                                                    star_index
      bulk BAM + FLARE      bulk  marine,sailor,    gtf, genome         star_index,
                                  flare             (+flare_* opts)     cellranger_ref
      bulk FASTQ + FLARE    bulk  marine,sailor,    gtf, genome,        cellranger_ref
                                  flare             star_index
                                                    (+flare_* opts)
      sc BAM-start          sc    marine            matrix_dir in       gtf, genome,
                                                    samplesheet         star_index,
                                                                        cellranger_ref,
                                                                        run_sailor/flare
      sc FASTQ-start        sc    marine            cellranger_ref      gtf, genome,
                                                                        star_index,
                                                                        run_sailor/flare

    ── SAMPLESHEET COLUMNS (params.input) ───────────────────────────────────────────
      bulk BAM      sample,bam,library_type                 library_type = SE | PE
      bulk FASTQ    sample,fastq_1,fastq_2,library_type     fastq_2 empty for SE
      sc   BAM      sample,bam,matrix_dir                   matrix_dir = filtered_feature_bc_matrix/
      sc   FASTQ    sample,fastq_dir                        dir holds {sample}_S1_L001_R{1,2}_001.fastq.gz
    Relative paths in the samplesheet resolve against the samplesheet's own directory.

    NOTE ON COMMENTING OUT: a commented-out param falls back to the default in
    nextflow.config (usually null), which is exactly what you want. Do NOT set a
    param to '' or 'none' to disable it — comment the whole line.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/* ════════════════════════════════════════════════════════════════════════════════
   0. RESOURCE CEILING
   Caps every process so nothing requests more than the node/allocation can give.
   Match this to your #SBATCH --cpus-per-task / --mem / --time.
   ═══════════════════════════════════════════════════════════════════════════════ */
process {
    resourceLimits = [
        cpus:   36,
        memory: '180.GB',
        time:   '24.h'
    ]
    // ── sc FASTQ-start (CellRanger) needs the big end of this: 32+ CPUs, 64+ GB.
    // ── FLARE runs long; bump time to 48.h for whole-genome RBP-STAMP.
}

// ── Re-running into the same --outdir? Uncomment so the reports overwrite ───────
// report.overwrite   = true
// timeline.overwrite = true
// trace.overwrite    = true
// dag.overwrite      = true


params {

    /* ════════════════════════════════════════════════════════════════════════════
       1. RUN IDENTITY — free text, shows in the Nextflow header and MultiQC
       ═══════════════════════════════════════════════════════════════════════════ */
    config_profile_name        = 'STAMP run'
    config_profile_description = 'Describe the experiment here: cell line, construct, genome, edit type, library'


    /* ════════════════════════════════════════════════════════════════════════════
       2. MODE + TOOL TOGGLES  — uncomment exactly ONE block
       ═══════════════════════════════════════════════════════════════════════════ */

    // ── (A) BULK riboSTAMP / RBP-STAMP without cluster calling ──────────────────
    mode       = 'bulk'
    run_marine = true      // MARINE edit calling; also drives STAR align + strandedness inference
    run_sailor = true      // SAILOR edit calling (Snakemake + Singularity, see §7)
    run_flare  = false     // leave false for riboSTAMP

    // ── (B) BULK RBP-STAMP with FLARE edit-cluster identification ───────────────
    //       (FLARE consumes SAILOR output, so run_sailor MUST stay true)
    // mode       = 'bulk'
    // run_marine = true
    // run_sailor = true
    // run_flare  = true

    // ── (C) SINGLE-CELL (10x Chromium) ──────────────────────────────────────────
    //       strandedness is fixed at 2 for 10x; no INFER_STRANDEDNESS, no SAILOR/FLARE
    // mode       = 'sc'
    // run_marine = true


    /* ════════════════════════════════════════════════════════════════════════════
       3. INPUT SAMPLESHEET  — always required. See column layouts in the header.
       ═══════════════════════════════════════════════════════════════════════════ */
    input = '/path/to/samplesheet.csv'


    /* ════════════════════════════════════════════════════════════════════════════
       4. REFERENCE FILES
       ═══════════════════════════════════════════════════════════════════════════ */

    // ── ALWAYS REQUIRED ─────────────────────────────────────────────────────────
    // fasta: genome FASTA. Must be the SAME assembly the BAMs were aligned to.
    //        Used for samtools calmd (MD tags) and by SAILOR.
    fasta    = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/GRCh38-2024-A_mruby_gfp/genome.fa'

    // gene_bed: BED6 gene models. Used by RSeQC (strandedness) and MARINE (annotation).
    //           Build one from a GTF with: bin/helper_make_bed_from_gtf.sh
    gene_bed = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/GRCh38-2024-A_mruby_gfp/genes_mruby_gfp.bed'

    // ── BULK ONLY — GTF for STAR + featureCounts (+ FLARE region generation) ────
    gtf      = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/GRCh38-2024-A_mruby_gfp/genes.gtf'

    // ── BULK FASTQ-START ONLY — pre-built STAR index directory ──────────────────
    // star_index = '/condo/brannanlab/tmhaxs421/reference/star_index_hg38'

    // ── SC FASTQ-START ONLY — CellRanger mkref output directory ─────────────────
    //    When set, fasta should point at <cellranger_ref>/fasta/genome.fa
    // cellranger_ref = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/mRuby3_mm10/mRUBY3_mm10'

    // ── MOUSE EXAMPLE (swap the three above) ────────────────────────────────────
    // fasta    = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/mRuby3_mm10/mRUBY3_mm10/fasta/genome.fa'
    // gene_bed = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/mRuby3_mm10/mRUBY3_mm10/genes/genes.bed'
    // gtf      = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/mRuby3_mm10/mRUBY3_mm10/genes/genes.gtf.gz'

    // ── iGenomes: keep OFF. This pipeline takes explicit reference paths above,
    //    and `genome` below only selects a bundled genePred for metaPlotR (§10) —
    //    it is NOT an igenomes key. With igenomes_ignore = false, main.nf's
    //    `params.fasta = getGenomeAttribute('fasta')` can resolve to an s3:// path.
    igenomes_ignore = true


    /* ════════════════════════════════════════════════════════════════════════════
       5. VARIANT FILTERING REFERENCE (dbSNP)
       Needed whenever filter_bulk_dbsnp / filter_sc_dbsnp is true, and by SAILOR.
       ═══════════════════════════════════════════════════════════════════════════ */
    // Must be a SINGLE file (the per-chromosome bed_chr_*.bed files in these dirs are
    // already concatenated into the *_combined.bed3 below). PREPARE_DBSNP sorts it.
    dbsnp_bed = '/condo/brannanlab/tmhaxs421/reference/dbSNP/dbsnp-hg38/hg38_bed/hg38_dbsnp_combined.bed3'
    // mm10:
    // dbsnp_bed = '/condo/brannanlab/tmhaxs421/reference/dbSNP/dbsnp142-mm10/mm10_dbsnp_combined.bed3'


    /* ════════════════════════════════════════════════════════════════════════════
       6. EDIT CALLING
       ═══════════════════════════════════════════════════════════════════════════ */
    // edit_type: 'C>T' = APOBEC1 cytidine deaminase (reverse strand)
    //            'A>G' = ADAR adenosine deaminase (sense strand)
    edit_type        = 'C>T'

    min_base_quality = 30
    // min_read_quality: 255 = uniquely-mapped (STAR and CellRanger both use 255).
    //   Drop to 0 only for subsampled/re-written BAMs whose MAPQ is no longer meaningful.
    min_read_quality = 255
    max_frac         = 0.1     // maximum editing fraction kept (see filter F3/F4 below)

    // strandedness: leave commented to auto-infer with RSeQC (needs gene_bed + run_marine).
    //   Set explicitly to skip inference — required for SAILOR when starting from BAM
    //   with run_marine = false.  0 = unstranded, 1 = fr-secondstrand, 2 = fr-firststrand
    // strandedness = 2

    // ── SC ONLY ─────────────────────────────────────────────────────────────────
    // min_count   = 3      // min cells with edited reads to keep a site
    // barcode_tag = 'CB'   // CellRanger standard cell-barcode tag


    /* ════════════════════════════════════════════════════════════════════════════
       7. EDIT FILTERS  — set false to SKIP that individual filter
       All default to true in nextflow.config. Test profiles turn them all off to
       maximise the number of sites reaching downstream steps; for real runs leave
       them on (i.e. leave this whole section commented out).
       ═══════════════════════════════════════════════════════════════════════════ */

    // ── BULK (bin/helper_filter_edits_bulk.py) ──────────────────────────────────
    // filter_bulk_multiallelic   = true   // F1: drop sites with >1 alt base at the same position
    // filter_bulk_dbsnp          = true   // F2: drop sites overlapping dbSNP  (needs dbsnp_bed)
    // filter_bulk_max_frac       = true   // F3: drop sites with edit_fraction > max_frac
    // filter_bulk_unannotated    = true   // F4: drop sites with no gene annotation

    // ── SC (bin/helper_filter_edits_sc.py) ──────────────────────────────────────
    // filter_sc_multi_conversion = true   // F1: drop barcodes with >1 conversion type per site
    // filter_sc_dbsnp            = true   // F2: drop sites overlapping dbSNP  (needs dbsnp_bed)
    // filter_sc_min_count        = true   // F3: drop sites with < min_count total edited reads
    // filter_sc_max_frac         = true   // F4: drop sites with edit_fraction > max_frac
    // filter_sc_unannotated      = true   // F5: drop sites with no gene annotation


    /* ════════════════════════════════════════════════════════════════════════════
       8. SAILOR / SNAKEMAKE  — bulk only, when run_sailor = true
       These same three sailor_* settings also drive FLARE (both are Snakemake).
       ═══════════════════════════════════════════════════════════════════════════ */
    // Absolute path to the snakemake binary, or 'snakemake' if already on PATH.
    sailor_snakemake_path    = '/cm/shared/apps/snakemake/9.13.4/bin/snakemake'

    // Reuse pulled Singularity images instead of re-downloading every run.
    // Defaults to $NXF_SINGULARITY_CACHEDIR if that is exported.
    sailor_singularity_cache = '/condo/brannanlab/tmhaxs421/singularity_cache'

    // Comma-separated bind paths for SAILOR's *internal* Singularity calls.
    // MUST cover wherever --fasta and --dbsnp_bed live, or SAILOR sees empty files.
    sailor_singularity_bind  = '/condo/brannanlab,/home/tmhaxs421'

    // Override only to run a different SAILOR version than the bundled one.
    // sailor_snakefile = "${projectDir}/assets/workflow_sailor/Snakefile"


    /* ════════════════════════════════════════════════════════════════════════════
       9. FLARE  — bulk only, when run_flare = true (RBP-STAMP edit clusters)
       ═══════════════════════════════════════════════════════════════════════════ */
    // flare_fdr            = 0.1    // FDR threshold for cluster/peak filtering
    // flare_max_merge_dist = 15     // max bp between adjacent significant peaks to merge

    // flare_regions: pre-built regions folder from generate_regions.py.
    //   Genome-level, ~8–10 GB, and REUSABLE — build it once and point every later
    //   run here. Leave commented to generate on-the-fly from --gtf (slow, cached).
    // flare_regions     = '/condo/brannanlab/tmhaxs421/reference/flare_regions_hg38'
    // flare_window_size = 30        // sliding-window size, only used when auto-generating

    // Override only to run a different FLARE version than the bundled one.
    // flare_snakefile = "${projectDir}/assets/workflow_FLARE/Snakefile"


    /* ════════════════════════════════════════════════════════════════════════════
       10. metaPlotR  — bulk only (SC has no metagene step)
       ═══════════════════════════════════════════════════════════════════════════ */
    // genome selects a bundled genePred from assets/genepred/.
    // Supported: hg19 | hg38 | hg38_V44 | mm10 | mm39
    genome = 'hg38'

    // For an unsupported/custom assembly, comment `genome` above and supply your own:
    // genepred = '/path/to/custom_refseq_genePred.txt.gz'


    /* ════════════════════════════════════════════════════════════════════════════
       11. LOCAL CONTAINER IMAGES (offline / air-gapped HPC)
       Leave commented to pull from Docker Hub. Set to a local .sif/.img when the
       node has no egress. See bin/offline.config for the full Wave-image workaround.
       ═══════════════════════════════════════════════════════════════════════════ */
    // marine_sif          = '/condo/brannanlab/tmhaxs421/singularity_cache/docker.io-aravindsundaravadivelu-marine-1.0.2.img'
    // ribostamp_utils_sif = '/condo/brannanlab/tmhaxs421/singularity_cache/docker.io-aravindsundaravadivelu-ribostamp_utils-1.0.0.img'
    // editc_sif           = '/condo/brannanlab/tmhaxs421/singularity_cache/editc_v2.img'   // FLARE region generation


    /* ════════════════════════════════════════════════════════════════════════════
       12. OUTPUT + REPORTING
       ═══════════════════════════════════════════════════════════════════════════ */
    // outdir is normally passed on the command line (--outdir) so one config can
    // serve several runs. Uncomment to pin it to this config instead.
    // outdir = '/path/to/my_project/results'

    // publish_dir_mode: 'copy' (safe, duplicates data) | 'symlink' (fast, breaks if
    //   the work dir is cleaned) | 'link' (hardlink, same filesystem only)
    // publish_dir_mode = 'copy'

    // multiqc_title  = 'STAMP — my experiment'
    // multiqc_config = '/path/to/custom_multiqc_config.yml'

    // email         = 'you@houstonmethodist.org'
    // email_on_fail = 'you@houstonmethodist.org'
}


/* ════════════════════════════════════════════════════════════════════════════════
   13. SINGULARITY CACHE (nextflow-managed images, separate from sailor_* above)
   Point every run at one shared cache so images are pulled once, not per-run.
   Equivalent to exporting NXF_SINGULARITY_CACHEDIR before launching.
   ═══════════════════════════════════════════════════════════════════════════════ */
// singularity.cacheDir = '/condo/brannanlab/tmhaxs421/singularity_cache'


/* ════════════════════════════════════════════════════════════════════════════════
   14. PER-PROCESS RESOURCE OVERRIDES
   conf/base.config already assigns sensible labels. Override here only when a
   specific step keeps failing on memory or walltime.
   ═══════════════════════════════════════════════════════════════════════════════ */
// process {
//     withName: 'STAR_ALIGN'    { cpus = 12; memory = '64.GB'; time = '8.h'  }
//     withName: 'CELLRANGER'    { cpus = 32; memory = '128.GB'; time = '24.h' }
//     withName: 'MARINE_BULK'   { cpus = 16; memory = '64.GB'; time = '12.h' }
//     withName: 'MARINE_SC'     { cpus = 16; memory = '96.GB'; time = '24.h' }
//     withName: 'SAILOR'        { cpus = 8;  memory = '32.GB'; time = '12.h' }
//     withName: 'FLARE'         { cpus = 8;  memory = '64.GB'; time = '24.h' }
//     withName: 'FLARE_GENERATE_REGIONS' { cpus = 8; memory = '96.GB'; time = '12.h' }  // ~8-10 GB output
// }
