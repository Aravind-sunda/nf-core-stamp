/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/stamp — MASTER RUN CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    EDIT BLOCK 1. NOTHING ELSE.

    Nothing in this file ever needs commenting or uncommenting. Every setting is
    always active; the ones your run does not use are simply ignored.

        cp conf/master.config  my_run.config
        # edit block 1 of my_run.config
        nextflow run /path/to/nf-core-stamp/main.nf \
            -c my_run.config -profile singularity --outdir results -resume

    Block 1 can also be overridden on the command line and everything still follows,
    so one file covers many runs:

        --refset mm10_mruby_apobec     swaps ALL references together
        --scenario sc_bam              switches mode and tool toggles together

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


// ═════════════════════════════════════════════════════════════════════════════
//  1.  THE ONLY BLOCK YOU EDIT
// ═════════════════════════════════════════════════════════════════════════════

// Path to your samplesheet. Which columns it needs depends on `scenario` —
// the table in block 5 lists them.
params.input = '/path/to/samplesheet.csv'


// What kind of run this is. Choose exactly one value:
//
//   bulk_bam           bulk, starting from aligned BAMs
//   bulk_fastq         bulk, starting from FASTQs (STAR aligns them)
//   bulk_bam_flare     bulk RBP-STAMP from BAMs,   adds FLARE edit clusters
//   bulk_fastq_flare   bulk RBP-STAMP from FASTQs, adds FLARE edit clusters
//   sc_bam             10x, starting from CellRanger BAMs + count matrices
//   sc_fastq           10x, starting from FASTQs (runs CellRanger; slow, needs 32 CPU / 64 GB)
//
params.scenario = 'bulk_bam'


// Which reference bundle to use. Choose exactly one value:
//
//   hg38_mruby_gfp      human  GRCh38-2024-A  + mRuby3 + GFP
//   mm10_mruby_apobec   mouse  mm10-2020-A    + mRuby3 + RPS2-APOBEC   (riboSTAMP)
//   mm10_mruby3         mouse  mm10           + mRuby3   (no bulk STAR index — not for *_fastq)
//
// Each bundle is one directory whose FASTA, GTF, BED, STAR index and CellRanger
// reference were all built together and share the same transgene contigs. Picking
// a bundle by name is what makes it impossible to pair, say, a human FASTA with a
// mouse gene model — so change this ONE value, never the paths in block 2.
params.refset = 'hg38_mruby_gfp'


// Which deaminase produced the edits:
//   'C>T'  APOBEC1 cytidine deaminase   (riboSTAMP / RBP-STAMP)
//   'A>G'  ADAR adenosine deaminase
params.edit_type = 'C>T'


// ═════════════════════════════════════════════════════════════════════════════
//  2.  DERIVED FROM BLOCK 1 — do not edit
//      Add a new genome by adding one row to each map below, not by editing
//      block 1 or hand-writing paths into a run.
// ═════════════════════════════════════════════════════════════════════════════

// ── Mode and tool toggles, derived from `scenario` ───────────────────────────
// Deriving these together is deliberate: run_flare without run_sailor, or
// run_flare in sc mode, are rejected by the pipeline. They cannot disagree here.
params.mode       = params.scenario.startsWith('sc') ? 'sc' : 'bulk'
params.run_marine = true
params.run_sailor = params.scenario.startsWith('bulk')
params.run_flare  = params.scenario.endsWith('_flare')

// ── Reference bundle root ────────────────────────────────────────────────────
params.refdir = '/condo/brannanlab/tmhaxs421/reference/cellranger_reference/custom_cellranger/' +
                [ hg38_mruby_gfp   : 'GRCh38-2024-A_mruby_gfp',
                  mm10_mruby_apobec: 'mm10_2020-A_mruby_apobec',
                  mm10_mruby3      : 'mRuby3_mm10' ][params.refset]

// ── Files within the bundle ──────────────────────────────────────────────────
// genome.fa and genes.gtf are named identically in all three bundles; the rest
// are not, so they are spelled out per bundle.
params.fasta = "${params.refdir}/genome.fa"
params.gtf   = "${params.refdir}/genes.gtf"

params.gene_bed = [ hg38_mruby_gfp   : "${params.refdir}/genes_mruby_gfp.bed",
                    mm10_mruby_apobec: "${params.refdir}/genes.bed",
                    mm10_mruby3      : "${params.refdir}/mRuby3_mm10_10x.bed" ][params.refset]

params.star_index = [ hg38_mruby_gfp   : "${params.refdir}/star_index_bulk",
                      mm10_mruby_apobec: "${params.refdir}/mm10_mruby_apobec_star_index",
                      mm10_mruby3      : null ][params.refset]

params.cellranger_ref = [ hg38_mruby_gfp   : "${params.refdir}/human_gfp_mruby_genome",
                          mm10_mruby_apobec: "${params.refdir}/mm10_mruby_apobec_genome",
                          mm10_mruby3      : "${params.refdir}/mRUBY3_mm10" ][params.refset]

// ── genePred for metaPlotR: the pipeline selects a bundled one from `genome` ──
params.genome = [ hg38_mruby_gfp   : 'hg38',
                  mm10_mruby_apobec: 'mm10',
                  mm10_mruby3      : 'mm10' ][params.refset]

// ── dbSNP ────────────────────────────────────────────────────────────────────
// Both files are already coordinate-sorted, so PREPARE_DBSNP symlinks them
// through instead of re-sorting ~15 GB on every run.
params.dbsnp_bed = [ hg38_mruby_gfp   : '/condo/brannanlab/tmhaxs421/reference/dbSNP/dbsnp-hg38/hg38_bed/hg38_dbsnp_combined.sorted.bed3',
                     mm10_mruby_apobec: '/condo/brannanlab/tmhaxs421/reference/dbSNP/dbsnp142-mm10/mm10_dbsnp_combined.bed3',
                     mm10_mruby3      : '/condo/brannanlab/tmhaxs421/reference/dbSNP/dbsnp142-mm10/mm10_dbsnp_combined.bed3' ][params.refset]

// `genome` above is a genePred selector, NOT an iGenomes key. Leaving iGenomes on
// would let main.nf resolve params.fasta to an s3:// path.
params.igenomes_ignore = true

// Shown in the Nextflow header and MultiQC so a run identifies itself.
params.config_profile_name        = "STAMP ${params.scenario}"
params.config_profile_description = "${params.scenario} | ${params.refset} | ${params.edit_type}"


// ═════════════════════════════════════════════════════════════════════════════
//  3.  SITE SETTINGS — correct for this HPC; set once, then forget
// ═════════════════════════════════════════════════════════════════════════════

// SAILOR and FLARE both shell out to Snakemake, which manages its own containers.
params.sailor_snakemake_path    = '/cm/shared/apps/snakemake/9.13.4/bin/snakemake'
params.sailor_singularity_cache = '/condo/brannanlab/tmhaxs421/singularity_cache'
// Bind paths for Snakemake's own Singularity calls. Must cover wherever the FASTA
// and dbSNP live, or SAILOR silently sees empty files.
params.sailor_singularity_bind  = '/condo/brannanlab,/home/tmhaxs421'

process {
    // Ceiling for every task. Match to your #SBATCH allocation.
    // sc_fastq (CellRanger) wants the high end: 32+ CPUs, 64+ GB.
    resourceLimits = [
        cpus:   36,
        memory: '180.GB',
        time:   '24.h'
    ]
}

// Let the timeline/report/trace files be rewritten when re-running into the
// same --outdir, instead of aborting with FileAlreadyExistsException.
report.overwrite   = true
timeline.overwrite = true
trace.overwrite    = true
dag.overwrite      = true


// ═════════════════════════════════════════════════════════════════════════════
//  4.  TUNING — these are the defaults; change a value, never comment a line
// ═════════════════════════════════════════════════════════════════════════════

// ── Edit calling ─────────────────────────────────────────────────────────────
params.min_base_quality = 30
// 255 = uniquely mapped (both STAR and CellRanger use 255).
// Lower this only for subsampled/rewritten BAMs whose MAPQ is no longer meaningful.
params.min_read_quality = 255
params.max_frac         = 0.1     // max editing fraction kept
params.min_count        = 3       // sc only: min cells with edited reads per site
params.barcode_tag      = 'CB'    // sc only: CellRanger cell-barcode tag

// Strandedness is inferred with RSeQC. Set 0 (unstranded), 1 (fr-secondstrand) or
// 2 (fr-firststrand) to skip inference. sc is always 2 and ignores this.
params.strandedness = null

// ── Edit filters: false skips that filter. Bulk set applies in bulk mode, sc in sc.
params.filter_bulk_multiallelic   = true   // >1 alt base at the same position
params.filter_bulk_dbsnp          = true   // overlaps dbSNP
params.filter_bulk_max_frac       = true   // edit_fraction > max_frac
params.filter_bulk_unannotated    = true   // no gene annotation

params.filter_sc_multi_conversion = true   // >1 conversion type per site per barcode
params.filter_sc_dbsnp            = true   // overlaps dbSNP
params.filter_sc_min_count        = true   // fewer than min_count edited reads
params.filter_sc_max_frac         = true   // edit_fraction > max_frac
params.filter_sc_unannotated      = true   // no gene annotation

// ── FLARE (used only by the *_flare scenarios) ───────────────────────────────
params.flare_fdr            = 0.1   // FDR for cluster/peak filtering
params.flare_max_merge_dist = 15    // max bp between peaks to merge
params.flare_window_size    = 30    // window for on-the-fly region generation
// A prebuilt regions folder from generate_regions.py is genome-level (~8-10 GB) and
// reusable. null regenerates it from the GTF each time. Build once, then set it here.
params.flare_regions        = null


// ═════════════════════════════════════════════════════════════════════════════
//  5.  SAMPLESHEET COLUMNS — reference only, nothing to edit
// ═════════════════════════════════════════════════════════════════════════════
//
//   scenario           columns
//   ─────────────────  ──────────────────────────────────────────────────────
//   bulk_bam           sample,bam,library_type              library_type = SE | PE
//   bulk_bam_flare     sample,bam,library_type
//   bulk_fastq         sample,fastq_1,fastq_2,library_type  fastq_2 empty for SE
//   bulk_fastq_flare   sample,fastq_1,fastq_2,library_type
//   sc_bam             sample,bam,matrix_dir                matrix_dir = filtered_feature_bc_matrix/
//   sc_fastq           sample,fastq_dir                     holds {sample}_S1_L001_R{1,2}_001.fastq.gz
//
// Relative paths inside a samplesheet resolve against the samplesheet's own
// directory, not the launch directory.
