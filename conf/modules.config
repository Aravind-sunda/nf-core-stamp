/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // GUNZIP is an intermediate decompression step — outputs are consumed by
    // downstream processes and should not appear in the results directory.
    withName: 'GUNZIP_GTF|GUNZIP_GENE_BED' {
        publishDir = [ enabled: false ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── SAILOR: override container/conda globally set by -profile ────────────
    // Snakemake manages its own containers (--use-singularity); the Nextflow
    // process must run on the bare host to avoid nested Singularity calls.
    // conda is enabled here even when the rest of the pipeline uses Singularity.
    withName: 'SAILOR' {
        conda   = 'bioconda::snakemake-minimal=9.13.4 conda-forge::python>=3.8'
        // Explicitly clear any container set by -profile singularity/docker
        container = null
    }

    // ── ribostamp_utils container ─────────────────────────────────────────────
    // Dockerfile: containers/ribostamp_utils/Dockerfile
    // Override with params.ribostamp_utils_sif to use a local pre-built SIF.
    withName: 'MERGE_COUNTS|FILTER_EDITS_BULK|NORMALIZE_EDITS_BULK|METAPLOTR_BULK|METAPLOTR_SAILOR|FILTER_EDITS_SC|NORMALIZE_EDITS_SC' {
        container = { params.ribostamp_utils_sif as String ?: 'docker.io/aravindsundaravadivelu/ribostamp_utils:1.0.0' }
    }

    // ── MARINE bulk/SC ────────────────────────────────────────────────────────
    // Dockerfile: containers/marine/Dockerfile
    // Override with params.marine_sif to use a local pre-built SIF.
    withName: 'MARINE_BULK|MARINE_SC' {
        container = { params.marine_sif as String ?: 'docker.io/aravindsundaravadivelu/marine:1.0.2' }
    }

    // ── CellRanger: community container (requires 10x license acceptance) ────
    withName: 'CELLRANGER' {
        container = 'nf-core/cellranger:9.0.1'
    }

}
