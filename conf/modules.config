/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // GUNZIP is an intermediate decompression step — outputs are consumed by
    // downstream processes and should not appear in the results directory.
    withName: 'GUNZIP_GTF|GUNZIP_GENE_BED' {
        publishDir = [ enabled: false ]
    }

    // PREPARE_DBSNP publishes a symlink, never a copy. A sorted hg38 dbSNP is ~15 GB,
    // and the default 'copy' above would duplicate it into every run's results dir —
    // including the common case where the input was already sorted and the task did
    // nothing but symlink it through. What lands in results/prepare/ is therefore a
    // pointer into the work dir, not an archival artefact: if you want a standalone
    // copy, take it from the work dir, or just let the sort run again next time.
    // pattern/saveAs strip the module's sorted/ subdirectory (which exists only to
    // keep the output name from colliding with the input) out of the results path.
    withName: 'PREPARE_DBSNP' {
        publishDir = [
            path:    { "${params.outdir}/prepare" },
            mode:    'symlink',
            pattern: "sorted/*",
            saveAs:  { fn -> fn.tokenize('/').last() }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── SAILOR: override container/conda globally set by -profile ────────────
    // Snakemake manages its own containers (--use-singularity); the Nextflow
    // SAILOR process must run on the bare host to avoid nested Singularity calls.
    //
    // container = null prevents any -profile singularity/docker container from
    // wrapping this process. The conda directive below is used ONLY when running
    // with -profile conda; it is silently ignored under -profile singularity
    // (because conda.enabled is false globally in that profile).
    //
    // When using -profile singularity: Snakemake must be pre-installed and
    // available on PATH (or set --sailor_snakemake_path to its full path).
    // A module load, pre-activated conda env, or system-installed snakemake
    // all satisfy this requirement.
    withName: 'SAILOR' {
        conda   = 'bioconda::snakemake-minimal=9.13.4 conda-forge::python>=3.8'
        container = null
    }

    // ── FLARE: same bare-host requirement as SAILOR ──────────────────────────
    // FLARE's Snakefile drives its own editc containers (--use-singularity), so
    // the Nextflow FLARE process must run on the host with no container wrapping.
    // Snakemake must be pre-installed (or set --sailor_snakemake_path).
    withName: 'FLARE' {
        conda   = 'bioconda::snakemake-minimal=9.13.4 conda-forge::python>=3.8'
        container = null
    }

    // Container selection for the editc (FLARE_GENERATE_REGIONS), ribostamp_utils
    // and MARINE images lives in the module files, not here. Reading params from a
    // config-scope closure makes Nextflow >=26 emit a spurious
    // "Access to undefined parameter" warning even when the param is declared;
    // the same closure as a process directive inside the module does not.
    // Dockerfiles: containers/ribostamp_utils/, containers/marine/
    // Overrides --editc_sif / --ribostamp_utils_sif / --marine_sif still apply.

    // ── CellRanger: community container (requires 10x license acceptance) ────
    withName: 'CELLRANGER' {
        container = 'nf-core/cellranger:9.0.1'
    }

}
