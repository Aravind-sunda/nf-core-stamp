/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEST PROFILE: test_bulk_bam_flare
    Mode:         Bulk RNA-seq, BAM-start — RBP-STAMP (SAILOR → FLARE)
    Species:      Human (hg38)
    Data:         HEK293T, RBFOX2-BAMR RBP-STAMP (dox on/off), SE
                  chr1-subsampled (~500k reads per sample)
    Edit type:    C>T (APOBEC1 cytidine deaminase)
    Tools tested: INFER_STRANDEDNESS → MARINE_BULK → SAILOR → FLARE
                  (+ FEATURECOUNTS → … → METAPLOTR_BULK → MULTIQC)
    Prerequisites:
      - RBFOX2 data (bin/make_test_dataset_flare.sh):
          assets/test_data/flare/bulk_bams/minusdox_chr1.bam
          assets/test_data/flare/bulk_bams/plusdox_chr1.bam
      - Shared chr1 refs (bin/make_test_dataset.sh):
          assets/test_data/refs/hg38_chr1.fa
          assets/test_data/refs/chr1_hg38_genes.gtf.gz
          assets/test_data/refs/chr1_hg38_genes.bed.gz
          assets/test_data/refs/chr1_hg38_dbsnp.bed
    SAILOR / FLARE prerequisites (must be configured per system):
      - Snakemake installed; set sailor_snakemake_path if not on PATH
      - Singularity available; the editc image (docker://ekofman/editc:v2) will be
        pulled for FLARE (region generation + peak calling). Pre-cache it and set
        sailor_singularity_cache to avoid re-pulling on each run.
    Run with:
      nextflow run . -profile singularity,test_bulk_bam_flare --outdir results_bam_flare
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   16,
        memory: '64.GB',
        time:   '4.h'
    ]
}

params {
    config_profile_name        = 'Test — bulk BAM-start FLARE (hg38)'
    config_profile_description = 'Bulk BAM-start RBP-STAMP: chr1-subsampled HEK293T RBFOX2-BAMR, hg38, C>T, SE, SAILOR→FLARE'

    // ── Mode ──────────────────────────────────────────────────────────────────
    mode       = 'bulk'
    run_marine = true      // infers strandedness on the BAMs; also runs the MARINE branch
    run_sailor = true      // required by FLARE
    run_flare  = true      // RBP-STAMP edit-cluster identification

    // ── Input ─────────────────────────────────────────────────────────────────
    input = "${projectDir}/assets/test_data/flare/samplesheets/samplesheet_bulk_bam_flare.csv"

    // ── Reference files (chr1-only, shared in assets/test_data/refs/) ─────────
    fasta    = "${projectDir}/assets/test_data/refs/hg38_chr1.fa"
    gtf      = "${projectDir}/assets/test_data/refs/chr1_hg38_genes.gtf.gz"
    gene_bed = "${projectDir}/assets/test_data/refs/chr1_hg38_genes.bed.gz"
    genome   = 'hg38'   // selects built-in hg38 genePred for metaPlotR

    // ── Variant filtering ─────────────────────────────────────────────────────
    dbsnp_bed = "${projectDir}/assets/test_data/refs/chr1_hg38_dbsnp.bed"

    // ── SAILOR ────────────────────────────────────────────────────────────────
    // sailor_snakefile defaults to ${projectDir}/assets/workflow_sailor/Snakefile (bundled)
    // Set sailor_snakemake_path if snakemake is not on PATH, e.g.:
    //   sailor_snakemake_path = '/path/to/conda/envs/snakemake/bin/snakemake'
    // Set sailor_singularity_cache to reuse pulled containers (SAILOR + FLARE + editc).

    // ── FLARE ─────────────────────────────────────────────────────────────────
    // flare_snakefile defaults to ${projectDir}/assets/workflow_FLARE/Snakefile (bundled).
    // flare_regions is left unset → the regions folder is generated on-the-fly from
    // the chr1 --gtf (small & fast for the test). Supply --flare_regions to reuse a
    // pre-built one. FLARE runs cluster-identification mode with these defaults:
    flare_fdr            = 0.1
    flare_max_merge_dist = 15

    // ── Edit calling ──────────────────────────────────────────────────────────
    edit_type        = 'C>T'
    min_base_quality = 30
    min_read_quality = 0      // relaxed: test BAMs are subsampled, not re-quality-filtered
    max_frac         = 0.1

    // ── Filters — all disabled for test (maximise sites reaching downstream steps)
    filter_bulk_multiallelic = false
    filter_bulk_dbsnp        = false
    filter_bulk_max_frac     = false
    filter_bulk_unannotated  = false
}
